<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.AMap" parent="Theme.Material3.Light.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/on_primary_color_light</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/on_primary_color_light</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Surface colors -->
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/on_primary_color_light</item>
        <!-- Background color. -->
        <item name="android:colorBackground">@color/white</item>
    </style>

    <style name="Theme.AMap" parent="Base.Theme.AMap">
        <item name="android:windowTranslucentStatus">true</item>
    </style>

    <style name="AppPopupMenu" parent="ThemeOverlay.Material3.Light">
        <item name="android:popupBackground">@drawable/bg_popup_menu</item>
    </style>
</resources>
